{
  "expo": {
    "name": "ListOChef",
    "slug": "ListOChef",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/ListoChefLogo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icons/ListoChefLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#BAE8A5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jomote.ListOChef",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/ListoChefLogo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.jomote.ListOChef"
    },
    "web": {
      "favicon": "./assets/icons/ListoChefLogo.png"
    },
    "plugins": [
      "expo-font",
      "./withCleartextTraffic"
    ],
    "extra": {
      "eas": {
        "projectId": "461a1fb2-f1ba-4c9f-8b24-87a7a8093b16"
      }
    }
  }
}
